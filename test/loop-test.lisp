;;;; test/loop-test.lisp -- the event loop: timers, cancel, UDP, TCP accept+read, cross-thread
;;;; POST, and a signalling callback that must not end the loop.
;;;; sbcl --script test/loop-test.lisp
(require :asdf)
(push (truename "./") asdf:*central-registry*)
(asdf:load-system "cl-transport/loop" :verbose nil)
(defpackage #:loop-test (:use #:cl #:cl-transport.sockets #:cl-transport.loop))
(in-package #:loop-test)
(defvar *fails* 0) (defvar *checks* 0)
(defun check (what ok) (incf *checks*) (unless ok (incf *fails*)) (format t "~a ~a~%" (if ok "ok  " "FAIL") what))
(defun turn-until (loop pred secs)
  (let ((end (+ (now-seconds) secs)))
    (loop until (or (funcall pred) (> (now-seconds) end)) do (run-once loop))
    (funcall pred)))

(let ((lp (make-event-loop :error-hook (lambda (c w) (declare (ignore c w)))))
      (order '()))
  ;; timers fire in due order, a cancelled one never does
  (after lp 0.05 (lambda () (push :b order)))
  (after lp 0.01 (lambda () (push :a order)))
  (let ((tm (after lp 0.02 (lambda () (push :x order))))) (cancel lp tm))
  (turn-until lp (lambda () (= (length order) 2)) 1)
  (check "timers in due order, cancelled one skipped" (equal (reverse order) '(:a :b)))
  ;; periodic, cancelled from inside its own callback
  (let ((n 0) tm)
    (setq tm (every-seconds lp 0.01 (lambda () (when (= (incf n) 3) (cancel lp tm)))))
    (turn-until lp (lambda () nil) 0.15)
    (check "periodic cancels itself after 3" (= n 3)))
  ;; a signalling callback does not end the loop
  (let ((after-ok nil))
    (after lp 0 (lambda () (error "boom")))
    (after lp 0.01 (lambda () (setq after-ok t)))
    (turn-until lp (lambda () after-ok) 1)
    (check "loop survives a signalling callback" (and after-ok (= 1 (getf (loop-stats lp) :errors)))))
  ;; UDP: a watch sees a datagram; the callback reads it through the peer handle
  (let* ((a (udp-open)) (b (udp-open :admit (constantly t))) (got nil))
    (watch lp b (lambda (ep) (multiple-value-bind (peer) (udp-accept ep)
                               (when peer (setq got (udp-peer-read peer nil))))))
    (udp-send a "127.0.0.1" (udp-local-port b) (coerce #(1 2 3) '(vector (unsigned-byte 8))))
    (turn-until lp (lambda () got) 1)
    (check "UDP datagram delivered to a watch" (equalp got #(1 2 3)))
    (unwatch lp b) (udp-close a) (udp-close b))
  ;; TCP: listener watch accepts, connection watch reads, both unwatch themselves at EOF
  (let* ((l (tcp-listen)) (data '()) (eof nil))
    (watch lp l (lambda (l) (let ((c (tcp-accept l :timeout-ms 0)))
                              (when c (watch lp c (lambda (c) (multiple-value-bind (o e) (tcp-read-available c)
                                                                (when (plusp (length o)) (push o data))
                                                                (when e (setq eof t) (unwatch lp c) (tcp-close c)))))))))
    (let ((cl (tcp-connect "127.0.0.1" (tcp-listener-port l))))
      (tcp-write cl (coerce #(9 8 7) '(vector (unsigned-byte 8))))
      (turn-until lp (lambda () data) 1)
      (tcp-close cl))
    (turn-until lp (lambda () eof) 1)
    (check "TCP accept + read + EOF via watches" (and eof (equalp (apply #'concatenate 'vector (reverse data)) #(9 8 7))))
    (check "connection unwatched itself" (= 1 (getf (loop-stats lp) :watches)))
    (unwatch lp l) (tcp-listener-close l))
  ;; POST from another thread, while the loop runs on its own thread; STOP ends RUN
  (let ((seen nil) (th (sb-thread:make-thread (lambda () (run lp)))))
    (post lp (lambda () (setq seen (eq sb-thread:*current-thread* (loop-thread lp)))))
    (sleep 0.1) (stop lp)
    (sb-thread:join-thread th :timeout 2)
    (check "POST runs on the loop's thread; STOP ends RUN" (and seen (not (running-p lp))))))
(format t "~d/~d~%" (- *checks* *fails*) *checks*)
(sb-ext:exit :code (if (zerop *fails*) 0 1))
